---
import { config } from "../../pectus.config";
const { footer, site, org } = config;
const year = new Date().getFullYear();
---
<footer class="border-t border-[var(--color-border)] mt-24">
  <div class="max-w-6xl mx-auto px-6 py-16 grid gap-12 md:grid-cols-[2fr_3fr]">
    <div>
      <p class="text-2xl font-semibold tracking-tight">{site.name}</p>
      <p class="mt-3 text-[var(--color-muted)] max-w-prose">{site.description}</p>
      <a
        href={footer.cta.href}
        class="inline-block mt-6 px-4 py-2 rounded-md text-sm font-medium bg-[var(--color-accent)] text-white hover:opacity-90"
      >{footer.cta.label}</a>
    </div>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-8">
      {footer.columns.map((col) => (
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-muted)]">{col.heading}</p>
          <ul class="mt-3 space-y-2 text-sm">
            {col.links.map((link) => (
              <li><a href={link.href} class="hover:text-[var(--color-accent)]">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <div class="border-t border-[var(--color-border)]">
    <div class="max-w-6xl mx-auto px-6 py-6 text-xs text-[var(--color-muted)] flex justify-between">
      <span>&copy; {year} {org.name}.</span>
      <span>Powered by Pectus.</span>
    </div>
  </div>
</footer>
