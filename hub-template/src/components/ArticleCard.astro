---
import type { Article } from "../lib/articles";
interface Props { article: Article; }
const { article } = Astro.props;
const href = `/content-hub/${article.slug}/`;
---
<a href={href} class="group flex flex-col rounded-lg overflow-hidden border border-[var(--color-border)] hover:border-[var(--color-accent)] transition-colors bg-white">
  {article.heroImage && (
    <div class="aspect-[16/9] overflow-hidden bg-[var(--color-surface-soft)]">
      <img
        src={article.heroImage}
        alt={article.title}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </div>
  )}
  <div class="p-5 flex-1 flex flex-col">
    {article.category && (
      <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-muted)]">{article.category}</p>
    )}
    <h3 class="mt-2 text-lg font-semibold leading-snug">{article.title}</h3>
    <p class="mt-2 text-sm text-[var(--color-muted)] line-clamp-3">{article.description}</p>
    <div class="mt-4 pt-4 border-t border-[var(--color-border)] flex items-center justify-between text-xs text-[var(--color-muted)]">
      <span>{article.author}</span>
      <span>{article.readTime}</span>
    </div>
  </div>
</a>
