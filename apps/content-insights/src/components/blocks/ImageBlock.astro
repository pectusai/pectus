---
interface Props {
  src: string;
  alt?: string;
  caption?: string;
}
const { src, alt = "", caption } = Astro.props;
---
<figure class="image-block">
  <img src={src} alt={alt} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
.image-block {
  max-width: 48rem;
  margin: 2.5rem auto;
  padding: 0 1.5rem;
}
.image-block img {
  width: 100%;
  height: auto;
  border-radius: 0.5rem;
}
.image-block figcaption {
  margin-top: 0.5rem;
  font-size: 0.875rem;
  color: var(--color-muted);
  text-align: center;
}
</style>
