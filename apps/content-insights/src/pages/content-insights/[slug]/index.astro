---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import BlockRenderer from "../../../components/BlockRenderer.astro";
import { ARTICLES, BY_SLUG } from "../../../lib/articles";
import { blogPostingLd, articleBreadcrumbs } from "../../../lib/schema";
import { config } from "../../../../pectus.config";

export function getStaticPaths() {
  return ARTICLES.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const article = BY_SLUG[slug as string];
if (!article) return Astro.redirect("/");

const site = Astro.site ?? new URL(config.site.url);
const ld = [blogPostingLd(article, site), articleBreadcrumbs(article, site)];
---
<BaseLayout
  title={article.title}
  description={article.description}
  ogType="article"
  articleMeta={{
    publishedTime: article.datePublished,
    modifiedTime: article.dateModified,
    author: article.author,
    section: article.category,
    image: article.heroImage,
  }}
  ldJson={ld}
>
  <Nav slot="header" />
  <article class="max-w-3xl mx-auto px-6 py-16">
    <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-muted)]">{article.category}</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-semibold tracking-tight leading-tight">{article.title}</h1>
    <p class="mt-4 text-lg text-[var(--color-muted)] leading-relaxed">{article.description}</p>
    <div class="mt-6 flex items-center gap-4 text-sm text-[var(--color-muted)] border-y border-[var(--color-border)] py-4">
      <span>{article.author}</span>
      <span>·</span>
      <span>{new Date(article.datePublished).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</span>
      <span>·</span>
      <span>{article.readTime}</span>
    </div>
    {article.heroImage && (
      <img src={article.heroImage} alt={article.title} class="mt-8 w-full rounded-lg" />
    )}
    <div class="mt-10">
      <BlockRenderer blocks={article.blocks} />
    </div>
  </article>
  <Footer slot="footer" />
</BaseLayout>
