{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@pectus/supabase": [
        "../connectors/supabase/client.ts"
      ],
      "@pectus/supabase/*": [
        "../connectors/supabase/*"
      ],
      "@pectus/anthropic": [
        "../connectors/anthropic/client.ts"
      ],
      "@pectus/google/oauth": [
        "../connectors/google/oauth.ts"
      ],
      "@pectus/google/service-account": [
        "../connectors/google/service-account.ts"
      ],
      "@pectus/google/gsc": [
        "../connectors/google/gsc.ts"
      ],
      "@pectus/google/ga4": [
        "../connectors/google/ga4.ts"
      ],
      "@pectus/github": [
        "../connectors/github/client.ts"
      ],
      "@pectus/cli/import-design": [
        "../cli/src/lib/import-design.ts"
      ],
      "@pectus/content-insights/templates": [
        "../apps/content-insights/templates/index.ts"
      ],
      "@pectus/content-insights/blocks": [
        "../apps/content-insights/src/components/blocks/types.ts"
      ],
      "@pectus/skills/*/schema": [
        "../skills/*/schema.ts"
      ],
      "@pectus/apps/*/insights/schema": [
        "../apps/*/insights/schema.ts"
      ],
      "@pectus/apps/ga4/fetch": [
        "../apps/ga4/fetch.ts"
      ],
      "@pectus/apps/ga4/schema": [
        "../apps/ga4/schema.ts"
      ],
      "@pectus/apps/gsc/fetch": [
        "../apps/gsc/fetch.ts"
      ],
      "@pectus/apps/gsc/schema": [
        "../apps/gsc/schema.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
