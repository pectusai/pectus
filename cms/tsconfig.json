{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@pectus/supabase": ["../apps/supabase/client.ts"],
      "@pectus/supabase/*": ["../apps/supabase/*"],
      "@pectus/anthropic": ["../apps/anthropic/client.ts"],
      "@pectus/google/oauth": ["../apps/google/oauth.ts"],
      "@pectus/google/service-account": ["../apps/google/service-account.ts"],
      "@pectus/google/gsc": ["../apps/google/gsc.ts"],
      "@pectus/google/ga4": ["../apps/google/ga4.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
