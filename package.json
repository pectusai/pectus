{
  "name": "pectus",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted creator insights kit. Connect your data, get a weekly content plan ranked by projected traffic.",
  "license": "MIT",
  "homepage": "https://pectus.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/pectusai/pectus.git"
  },
  "workspaces": [
    "apps/*",
    "connectors/*",
    "cli",
    "cms"
  ],
  "scripts": {
    "dev": "npm --workspace cms run dev",
    "build": "npm --workspaces --if-present run build",
    "doctor": "npx pectus doctor",
    "update": "npx pectus update"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
