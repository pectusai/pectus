# Pectus environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
# Account-scoped Management API token. Generate at
# https://supabase.com/dashboard/account/tokens (starts with sbp_).
SUPABASE_ACCESS_TOKEN=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Google (GSC + GA4) ---
# Created via Google Cloud Console; pectus connect google walks you through it
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Content-hub preview (PR12) ---
# URL of the locally-running content-hub for the builder iframe preview.
# Default works for `npm --workspace @pectus/content-hub run dev`.
PECTUS_PREVIEW_URL=http://localhost:4321

# --- Vercel (optional, for deploying the hub-template) ---
VERCEL_TOKEN=

# --- GitHub (optional, for fork sync helpers) ---
GITHUB_TOKEN=
