# Pectus environment variables
# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Google (GSC + GA4) ---
# Created via Google Cloud Console; pectus connect google walks you through it
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Vercel (optional, for deploying the hub-template) ---
VERCEL_TOKEN=

# --- GitHub (optional, for fork sync helpers) ---
GITHUB_TOKEN=
